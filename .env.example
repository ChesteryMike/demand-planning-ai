# =====================================================================
# Demand Planning AI · variables de entorno (valores FICTICIOS)
# Copie este archivo como .env y complete los valores reales.
# .env nunca se sube a Git (regla 1). En Cloud Run, los secretos van en
# Secret Manager (8.3).
# =====================================================================

# Supabase (local: `npx supabase status -o env`; remoto: Project Settings → API)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=clave-anon-ficticia
# Solo servidor: se salta RLS. Nunca en el navegador ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=clave-service-role-ficticia

# IA (6.8): sin valores por defecto en el código.
PROVEEDOR_IA=anthropic
# ID explícito del modelo. Ejemplo verificado en la Fase 0:
# MODELO_IA=claude-haiku-5-5
MODELO_IA=
ANTHROPIC_API_KEY=clave-anthropic-ficticia
# OPENAI_API_KEY=clave-openai-ficticia

# Topes diarios de llamadas a la IA (por negocio y global, 6.8)
TOPE_DIARIO_IA=200
TOPE_DIARIO_IA_GLOBAL=500

# Sal para el hash de las IP del límite por IP (6.10). Cadena larga y aleatoria.
SAL_IP=sal-ficticia-cambiar
